@model AttendanceSheetViewModel
@{
    ViewData["Title"] = "Attendance";
    ViewData["Section"] = "Business data";
    var isToday = Model.Date.Date == DateTime.Today;
}
<div class="page-head">
    <div>
        <h1>Attendance for @(isToday ? "today" : Model.Date.ToString("dddd, dd MMM yyyy"))</h1>
        <p>Mark everyone, then save. Employees marked absent today receive an attendance alert on the next trigger scan.</p>
    </div>
    <form method="get" asp-action="Index" class="d-flex gap-2 align-items-center">
        <input type="date" name="date" value="@Model.Date.ToString("yyyy-MM-dd")" max="@DateTime.Today.ToString("yyyy-MM-dd")" class="form-control" aria-label="Date" />
        <button class="btn btn-soft" type="submit">Open</button>
    </form>
</div>

<div class="row g-4">
    <div class="col-xl-8">
        <form asp-action="Save" method="post" class="panel panel-flush">
            <input type="hidden" name="Date" value="@Model.Date.ToString("yyyy-MM-dd")" />
            @if (!Model.Rows.Any())
            {
                <partial name="_EmptyState" model='new EmptyStateModel("bi-people", "No active employees", "Add employees first, then record attendance here.")' />
            }
            else
            {
                <div class="table-wrap">
                    <table class="table">
                        <thead><tr><th>Employee</th><th>Status</th><th>Remarks</th></tr></thead>
                        <tbody>
                            @for (var i = 0; i < Model.Rows.Count; i++)
                            {
                                var row = Model.Rows[i];
                                <tr>
                                    <td>
                                        <input type="hidden" name="Rows[@i].EmployeeId" value="@row.EmployeeId" />
                                        <input type="hidden" name="Rows[@i].EmployeeName" value="@row.EmployeeName" />
                                        <input type="hidden" name="Rows[@i].Department" value="@row.Department" />
                                        <div class="cell-title">@row.EmployeeName</div>
                                        <div class="cell-sub">@row.Department @(row.IsRecorded ? "" : " (not recorded yet)")</div>
                                    </td>
                                    <td>
                                        <div class="segmented">
                                            @foreach (var st in Attendance.Statuses)
                                            {
                                                var id = $"att-{row.EmployeeId}-{st}";
                                                <input type="radio" id="@id" name="Rows[@i].Status" value="@st" checked="@(row.Status == st)" />
                                                <label for="@id">@st</label>
                                            }
                                        </div>
                                    </td>
                                    <td><input name="Rows[@i].Remarks" value="@row.Remarks" class="form-control form-control-sm" maxlength="200" placeholder="Optional" aria-label="Remarks" /></td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
                <div class="d-flex justify-content-end p-3">
                    <button class="btn btn-ink" type="submit"><i class="bi bi-check2-circle me-1"></i> Save attendance</button>
                </div>
            }
        </form>
    </div>
    <div class="col-xl-4">
        <div class="panel">
            <h3 class="mb-3">Last 7 days: absences, late and leave</h3>
            @if (!Model.RecentExceptions.Any())
            {
                <p class="text-muted mb-0">Everyone was present.</p>
            }
            else
            {
                foreach (var a in Model.RecentExceptions.Take(12))
                {
                    <div class="d-flex justify-content-between align-items-center py-2 border-bottom">
                        <div><div class="cell-title">@a.EmployeeName</div><div class="cell-sub">@a.AttendanceDate.ToString("ddd, dd MMM")</div></div>
                        <span class="pill @UiHelper.StatusClass(a.Status)">@a.Status</span>
                    </div>
                }
            }
        </div>
    </div>
</div>
