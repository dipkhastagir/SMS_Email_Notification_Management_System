@model Employee
@{
    var isEdit = Model.EmployeeId > 0;
    ViewData["Title"] = isEdit ? "Edit employee" : "Add employee";
    ViewData["Section"] = "Employees";
}
<div class="page-head"><div><h1>@ViewData["Title"]</h1></div></div>
<div class="panel" style="max-width:720px">
    <form asp-action="@(isEdit ? "Edit" : "Create")" method="post">
        <input type="hidden" asp-for="EmployeeId" />
        <div class="row g-3">
            <div class="col-sm-7">
                <div class="form-floating"><input asp-for="FullName" class="form-control" placeholder=" " /><label asp-for="FullName"></label></div>
                <span asp-validation-for="FullName"></span>
            </div>
            <div class="col-sm-5">
                <div class="form-floating"><input asp-for="JoinedAt" type="date" class="form-control" /><label asp-for="JoinedAt"></label></div>
            </div>
            <div class="col-sm-5">
                <div class="form-floating"><input asp-for="Phone" class="form-control" placeholder=" " /><label asp-for="Phone"></label></div>
                <span asp-validation-for="Phone"></span>
            </div>
            <div class="col-sm-7">
                <div class="form-floating"><input asp-for="Email" class="form-control" placeholder=" " /><label asp-for="Email">Email (optional)</label></div>
                <span asp-validation-for="Email"></span>
            </div>
            <div class="col-sm-4">
                <div class="form-floating"><input asp-for="Department" class="form-control" placeholder=" " list="departments" /><label asp-for="Department"></label></div>
                <datalist id="departments"><option value="Software"></option><option value="Accounts"></option><option value="HR"></option><option value="Sales"></option><option value="Support"></option></datalist>
                <span asp-validation-for="Department"></span>
            </div>
            <div class="col-sm-4">
                <div class="form-floating"><input asp-for="Designation" class="form-control" placeholder=" " /><label asp-for="Designation"></label></div>
            </div>
            <div class="col-sm-4">
                <div class="form-floating"><input asp-for="Salary" class="form-control" placeholder=" " step="0.01" min="0" /><label asp-for="Salary">Monthly salary (Tk)</label></div>
                <span asp-validation-for="Salary"></span>
            </div>
        </div>
        <div class="form-check form-switch mt-3">
            <input asp-for="IsActive" class="form-check-input" role="switch" />
            <label asp-for="IsActive" class="form-check-label ms-2">Active</label>
        </div>
        <div class="d-flex gap-2 mt-4">
            <button class="btn btn-ink" type="submit">Save employee</button>
            <a class="btn btn-soft" asp-action="Index">Cancel</a>
        </div>
    </form>
</div>
@section Scripts { <partial name="_ValidationScriptsPartial" /> }
