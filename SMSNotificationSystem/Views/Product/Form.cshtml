@model Product
@{
    var isEdit = Model.ProductId > 0;
    ViewData["Title"] = isEdit ? "Edit product" : "New product";
    ViewData["Section"] = "Stock";
}
<div class="page-head"><div><h1>@ViewData["Title"]</h1></div></div>
<div class="panel" style="max-width:640px">
    <form asp-action="@(isEdit ? "Edit" : "Create")" method="post">
        <input type="hidden" asp-for="ProductId" />
        <div class="row g-3">
            <div class="col-sm-8">
                <div class="form-floating"><input asp-for="ProductName" class="form-control" placeholder=" " /><label asp-for="ProductName"></label></div>
                <span asp-validation-for="ProductName"></span>
            </div>
            <div class="col-sm-4">
                <div class="form-floating"><input asp-for="Sku" class="form-control" placeholder=" " /><label asp-for="Sku"></label></div>
            </div>
            <div class="col-sm-4">
                <div class="form-floating"><input asp-for="StockQty" class="form-control" placeholder=" " min="0" /><label asp-for="StockQty"></label></div>
                <span asp-validation-for="StockQty"></span>
            </div>
            <div class="col-sm-4">
                <div class="form-floating"><input asp-for="ReorderLevel" class="form-control" placeholder=" " min="0" /><label asp-for="ReorderLevel"></label></div>
                <span asp-validation-for="ReorderLevel"></span>
            </div>
            <div class="col-sm-4">
                <div class="form-floating"><input asp-for="UnitPrice" class="form-control" placeholder=" " step="0.01" min="0" /><label asp-for="UnitPrice">Unit price (Tk)</label></div>
                <span asp-validation-for="UnitPrice"></span>
            </div>
        </div>
        <div class="d-flex gap-2 mt-4">
            <button class="btn btn-ink" type="submit">Save product</button>
            <a class="btn btn-soft" asp-action="Index">Cancel</a>
        </div>
    </form>
</div>
@section Scripts { <partial name="_ValidationScriptsPartial" /> }
