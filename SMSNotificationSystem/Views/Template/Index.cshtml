@model IEnumerable<TemplateWithCategoryDto>
@{
    ViewData["Title"] = "Templates";
    ViewData["Section"] = "Messaging";
    var canEdit = User.IsInRole(AppRoles.Administrator) || User.IsInRole(AppRoles.Manager);
    string? channel = ViewBag.Channel;
}
<div class="page-head">
    <div>
        <h1>Message templates</h1>
        <p>Reusable messages with placeholders such as {CustomerName} that are filled in with real data when a trigger fires.</p>
    </div>
    <div class="page-actions">
        @if (canEdit)
        {
            <a class="btn btn-soft" asp-controller="Category" asp-action="Index"><i class="bi bi-tags me-1"></i> Categories</a>
            <a class="btn btn-ink" asp-action="Create"><i class="bi bi-plus-lg me-1"></i> New template</a>
        }
    </div>
</div>

<div class="filter-tabs mb-3">
    <a class="@(string.IsNullOrEmpty(channel) ? "active" : "")" asp-action="Index">All</a>
    <a class="@(channel == "SMS" ? "active" : "")" asp-action="Index" asp-route-channel="SMS"><i class="bi bi-phone me-1"></i>SMS</a>
    <a class="@(channel == "Email" ? "active" : "")" asp-action="Index" asp-route-channel="Email"><i class="bi bi-envelope me-1"></i>Email</a>
</div>

@if (!Model.Any())
{
    <div class="panel"><partial name="_EmptyState" model='new EmptyStateModel("bi-chat-square-text", "No templates yet", "Create a template, then attach it to a trigger to start sending automatically.")' /></div>
}
else
{
    <div class="row g-4">
        @foreach (var t in Model)
        {
            <div class="col-md-6 col-xxl-4">
                <article class="panel h-100 d-flex flex-column">
                    <div class="d-flex justify-content-between align-items-start gap-2 mb-2">
                        <div>
                            <h3 class="mb-1">@t.Name</h3>
                            <div class="cell-sub">@t.CategoryName, used by @t.TriggerCount trigger@(t.TriggerCount == 1 ? "" : "s")</div>
                        </div>
                        <span class="pill @UiHelper.StatusClass(t.Status)">@t.Status</span>
                    </div>
                    <div class="preview-shell my-3 flex-grow-1">
                        @if (t.Channel == "Email")
                        {
                            <div class="bubble"><div class="email-subject">@t.Subject</div>@t.Body</div>
                        }
                        else
                        {
                            <div class="bubble">@t.Body</div>
                        }
                    </div>
                    <div class="d-flex align-items-center justify-content-between gap-2 flex-wrap">
                        <span class="channel"><i class="bi @UiHelper.ChannelIcon(t.Channel)"></i>@t.Channel</span>
                        <div class="row-actions">
                            <button class="btn btn-soft btn-sm" type="button" data-bs-toggle="collapse" data-bs-target="#test-@t.TemplateId"
                                    aria-expanded="false" aria-controls="test-@t.TemplateId"><i class="bi bi-send"></i> Test</button>
                            @if (canEdit)
                            {
                                <a class="btn btn-soft btn-sm" asp-action="Edit" asp-route-id="@t.TemplateId"><i class="bi bi-pencil"></i> Edit</a>
                                <form asp-action="ToggleStatus" asp-route-id="@t.TemplateId" method="post">
                                    <button class="btn btn-soft btn-sm" type="submit" title="@(t.Status == "Active" ? "Pause" : "Activate")">
                                        <i class="bi @(t.Status == "Active" ? "bi-pause" : "bi-play")"></i>
                                    </button>
                                </form>
                                <form asp-action="Delete" asp-route-id="@t.TemplateId" method="post"
                                      data-confirm="Delete the template &quot;@t.Name&quot;? Messages already queued keep their text.">
                                    <button class="btn btn-danger-soft btn-sm" type="submit" aria-label="Delete"><i class="bi bi-trash"></i></button>
                                </form>
                            }
                        </div>
                    </div>
                    <div class="collapse" id="test-@t.TemplateId">
                        <form asp-action="SendTest" asp-route-id="@t.TemplateId" method="post" class="d-flex gap-2 mt-3">
                            <input name="contact" class="form-control form-control-sm" required
                                   placeholder="@(t.Channel == "Email" ? "you@company.com" : "+8801XXXXXXXXX")" aria-label="Send test to" />
                            <button class="btn btn-ink btn-sm" type="submit">Queue test</button>
                        </form>
                    </div>
                </article>
            </div>
        }
    </div>
}
