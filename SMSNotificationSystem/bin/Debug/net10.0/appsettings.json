{
  "ConnectionStrings": {
    "DefaultConnection": "Server=.;Database=SmsNotificationDB;Trusted_Connection=True;TrustServerCertificate=True;MultipleActiveResultSets=True"
  },
  "Database": {
    "AutoSetup": true,
    "RecreateIfOutdated": true
  },
  "Notification": {
    "CompanyName": "Best Business Bond Ltd.",
    "MaxRetries": 3,
    "DispatchBatchSize": 25,
    "SimulatedSuccessRate": 90,
    "TriggerScanCron": "*/5 * * * *",
    "DispatchCron": "* * * * *"
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Hangfire": "Information"
    }
  },
  "AllowedHosts": "*"
}
