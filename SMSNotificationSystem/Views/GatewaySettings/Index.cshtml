@model IEnumerable<GatewaySetting>
@{
    ViewData["Title"] = "Gateways";
    ViewData["Section"] = "Settings";
}
<div class="page-head">
    <div>
        <h1>SMS &amp; Email gateways</h1>
        <p>The dispatch job sends each channel through its primary active gateway. During development these are simulated, so nothing leaves the machine.</p>
    </div>
    <div class="page-actions"><a class="btn btn-ink" asp-action="Create"><i class="bi bi-plus-lg me-1"></i> Add gateway</a></div>
</div>

<div class="row g-4">
    @foreach (var g in Model)
    {
        <div class="col-md-6 col-xl-4">
            <div class="panel h-100">
                <div class="d-flex justify-content-between align-items-start mb-3">
                    <div class="metric">
                        <span class="m-icon @(g.Channel == "Email" ? "tint-info" : "tint-warn")"><i class="bi @UiHelper.ChannelIcon(g.Channel)"></i></span>
                        <div><h3 class="mb-0">@g.Provider</h3><div class="cell-sub">@g.Channel gateway</div></div>
                    </div>
                    <span class="pill @(g.IsActive ? "pill-ok" : "pill-muted")">@(g.IsActive ? "Active" : "Off")</span>
                </div>
                <dl class="row small mb-3">
                    <dt class="col-5 text-muted fw-normal">Sender</dt><dd class="col-7">@g.SenderId</dd>
                    <dt class="col-5 text-muted fw-normal">API key</dt><dd class="col-7"><code>@UiHelper.MaskSecret(g.ApiKey)</code></dd>
                    <dt class="col-5 text-muted fw-normal">Role</dt><dd class="col-7">@(g.IsPrimary ? "Primary" : "Backup")</dd>
                </dl>
                <div class="row-actions justify-content-start">
                    <a class="btn btn-soft btn-sm" asp-action="Edit" asp-route-id="@g.GatewayId"><i class="bi bi-pencil"></i> Edit</a>
                    <form asp-action="Delete" asp-route-id="@g.GatewayId" method="post" data-confirm="Remove the gateway &quot;@g.Provider&quot;?">
                        <button class="btn btn-danger-soft btn-sm" type="submit"><i class="bi bi-trash"></i> Remove</button>
                    </form>
                </div>
            </div>
        </div>
    }
</div>
@if (!Model.Any())
{
    <div class="panel"><partial name="_EmptyState" model='new EmptyStateModel("bi-hdd-network", "No gateways configured", "Messages will fail until an active SMS and Email gateway exist.")' /></div>
}
